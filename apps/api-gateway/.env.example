# Порт, на якому слухає api-gateway
PORT=3000

# Джерело, якому дозволено крос-доменні запити (dev-сервер Vite)
WEB_ORIGIN=http://localhost:5173

# Рівень логування (error, warn, info, debug)
LOG_LEVEL=debug
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/api_gateway?schema=public
PRISMA_LOG=off
